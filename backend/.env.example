# Copy this file to .env and fill in your own Supabase Postgres connection
# string (Project Settings -> Database -> Connection string -> URI, on the
# Supabase dashboard).
#
# IMPORTANT:
#   - If your password contains "@", percent-encode it as "%40" (otherwise
#     it gets misread as the user@host separator).
#   - Keep "?ssl=require" -- Supabase's direct (non-pooled) connection on
#     port 5432 requires it.
DATABASE_URL=postgresql+asyncpg://postgres:Kamyasaini%402008@db.bnazyjnfyvhuyovyedke.supabase.co:5432/postgres?ssl=require
